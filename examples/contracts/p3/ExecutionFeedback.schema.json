{
  "$defs": {
    "BranchArc": {
      "additionalProperties": false,
      "description": "Coverage arcs may use negative line numbers for code-object exits.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "BranchArc",
      "type": "object"
    },
    "CoverageResult": {
      "additionalProperties": false,
      "properties": {
        "target_file": {
          "format": "path",
          "title": "Target File",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "covered_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covered Lines"
        },
        "total_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Lines"
        },
        "covered_branches": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covered Branches"
        },
        "total_branches": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Branches"
        },
        "missing_lines": {
          "default": [],
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Missing Lines",
          "type": "array"
        },
        "missing_branches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BranchArc"
          },
          "title": "Missing Branches",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "target_file",
        "status"
      ],
      "title": "CoverageResult",
      "type": "object"
    },
    "ExecutionKind": {
      "enum": [
        "passed",
        "assertion_failed",
        "execution_error",
        "collection_error",
        "internal_error",
        "usage_error",
        "interrupted",
        "no_tests",
        "timeout",
        "launch_error",
        "result_error"
      ],
      "title": "ExecutionKind",
      "type": "string"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "description": "Tool observations. Null counters mean unknown, not an observed zero.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExecutionKind"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "collected": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected"
        },
        "executed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executed"
        },
        "passed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "failed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed"
        },
        "errors": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errors"
        },
        "skipped": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped"
        },
        "xfailed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xfailed"
        },
        "xpassed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xpassed"
        },
        "stdout": {
          "default": "",
          "title": "Stdout",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "title": "Stderr",
          "type": "string"
        },
        "timed_out": {
          "default": false,
          "title": "Timed Out",
          "type": "boolean"
        },
        "stdout_truncated": {
          "default": false,
          "title": "Stdout Truncated",
          "type": "boolean"
        },
        "stderr_truncated": {
          "default": false,
          "title": "Stderr Truncated",
          "type": "boolean"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "failures": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FailureObservation"
          },
          "title": "Failures",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "exit_code"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "FailureObservation": {
      "additionalProperties": false,
      "description": "Structured pytest exception facts, never supplied by generation output.",
      "properties": {
        "nodeid": {
          "minLength": 1,
          "title": "Nodeid",
          "type": "string"
        },
        "phase": {
          "enum": [
            "collection",
            "setup",
            "call",
            "teardown"
          ],
          "title": "Phase",
          "type": "string"
        },
        "exception_type": {
          "minLength": 1,
          "title": "Exception Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "missing_module": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Module"
        }
      },
      "required": [
        "nodeid",
        "phase",
        "exception_type"
      ],
      "title": "FailureObservation",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "suspected_source_defect",
            "ambiguous_specification",
            "generation_error",
            "environment_error",
            "coverage_unavailable",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "round_number": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round Number"
        },
        "scenario_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExecutionResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coverage": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverageResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "validation_error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Error"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "protected_tests": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Protected Tests",
      "type": "array"
    },
    "source_hints_json": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Hints Json"
    }
  },
  "required": [
    "candidate_id"
  ],
  "title": "ExecutionFeedback",
  "type": "object"
}
