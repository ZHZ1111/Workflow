{
  "$defs": {
    "AgentAction": {
      "enum": [
        "analyze_source",
        "generate_tests",
        "run_tests",
        "repair_generated_test",
        "add_missing_cases",
        "request_review",
        "finish"
      ],
      "title": "AgentAction",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "candidate",
            "tests",
            "demo_observation",
            "execution",
            "coverage",
            "report",
            "agentdev_candidate",
            "plan",
            "llm_result",
            "subject",
            "assessment",
            "execution_evidence"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "round": {
          "maximum": 3,
          "minimum": 1,
          "title": "Round",
          "type": "integer"
        },
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256",
        "round",
        "candidate_id"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BranchArc": {
      "additionalProperties": false,
      "description": "Coverage arcs may use negative line numbers for code-object exits.",
      "properties": {
        "start": {
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "title": "End",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "BranchArc",
      "type": "object"
    },
    "CoverageResult": {
      "additionalProperties": false,
      "properties": {
        "target_file": {
          "format": "path",
          "title": "Target File",
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "covered_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covered Lines"
        },
        "total_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Lines"
        },
        "covered_branches": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Covered Branches"
        },
        "total_branches": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Branches"
        },
        "missing_lines": {
          "default": [],
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "title": "Missing Lines",
          "type": "array"
        },
        "missing_branches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BranchArc"
          },
          "title": "Missing Branches",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "target_file",
        "status"
      ],
      "title": "CoverageResult",
      "type": "object"
    },
    "ExecutionFeedback": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "#/$defs/CoverageResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validation_error": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Error"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Issue"
          },
          "title": "Issues",
          "type": "array"
        },
        "protected_tests": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Protected Tests",
          "type": "array"
        },
        "source_hints_json": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Hints Json"
        }
      },
      "required": [
        "candidate_id"
      ],
      "title": "ExecutionFeedback",
      "type": "object"
    },
    "ExecutionKind": {
      "enum": [
        "passed",
        "assertion_failed",
        "execution_error",
        "collection_error",
        "internal_error",
        "usage_error",
        "interrupted",
        "no_tests",
        "timeout",
        "launch_error",
        "result_error"
      ],
      "title": "ExecutionKind",
      "type": "string"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "description": "Tool observations. Null counters mean unknown, not an observed zero.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ExecutionKind"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "collected": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collected"
        },
        "executed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executed"
        },
        "passed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Passed"
        },
        "failed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failed"
        },
        "errors": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errors"
        },
        "skipped": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skipped"
        },
        "xfailed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xfailed"
        },
        "xpassed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xpassed"
        },
        "stdout": {
          "default": "",
          "title": "Stdout",
          "type": "string"
        },
        "stderr": {
          "default": "",
          "title": "Stderr",
          "type": "string"
        },
        "timed_out": {
          "default": false,
          "title": "Timed Out",
          "type": "boolean"
        },
        "stdout_truncated": {
          "default": false,
          "title": "Stdout Truncated",
          "type": "boolean"
        },
        "stderr_truncated": {
          "default": false,
          "title": "Stderr Truncated",
          "type": "boolean"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "failures": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FailureObservation"
          },
          "title": "Failures",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "exit_code"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "FailureObservation": {
      "additionalProperties": false,
      "description": "Structured pytest exception facts, never supplied by generation output.",
      "properties": {
        "nodeid": {
          "minLength": 1,
          "title": "Nodeid",
          "type": "string"
        },
        "phase": {
          "enum": [
            "collection",
            "setup",
            "call",
            "teardown"
          ],
          "title": "Phase",
          "type": "string"
        },
        "exception_type": {
          "minLength": 1,
          "title": "Exception Type",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "missing_module": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Module"
        }
      },
      "required": [
        "nodeid",
        "phase",
        "exception_type"
      ],
      "title": "FailureObservation",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "suspected_source_defect",
            "ambiguous_specification",
            "generation_error",
            "environment_error",
            "coverage_unavailable",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "evidence": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "round_number": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round Number"
        },
        "scenario_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario Id"
        }
      },
      "required": [
        "kind",
        "summary"
      ],
      "title": "Issue",
      "type": "object"
    },
    "StopReason": {
      "enum": [
        "coverage_target_met",
        "round_limit_reached",
        "no_progress",
        "suspected_source_defect",
        "ambiguous_specification",
        "execution_timeout",
        "unrecoverable_error"
      ],
      "title": "StopReason",
      "type": "string"
    },
    "TaskStatus": {
      "enum": [
        "completed",
        "partial",
        "needs_review",
        "failed"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "minLength": 1,
      "title": "Candidate Id",
      "type": "string"
    },
    "observation_mode": {
      "default": "real",
      "enum": [
        "real",
        "injected"
      ],
      "title": "Observation Mode",
      "type": "string"
    },
    "tool_calls": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Tool Calls",
      "type": "integer"
    },
    "pytest_started": {
      "default": false,
      "title": "Pytest Started",
      "type": "boolean"
    },
    "action": {
      "$ref": "#/$defs/AgentAction"
    },
    "recommendation": {
      "enum": [
        "finish",
        "repair_tests",
        "extend_tests",
        "request_review",
        "stop_error"
      ],
      "title": "Recommendation",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "stop_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/StopReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "task_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feedback": {
      "$ref": "#/$defs/ExecutionFeedback"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "integrity_error": {
      "anyOf": [
        {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Integrity Error"
    }
  },
  "required": [
    "candidate_id",
    "action",
    "recommendation",
    "reason",
    "feedback"
  ],
  "title": "ExecutionAssessment",
  "type": "object"
}
