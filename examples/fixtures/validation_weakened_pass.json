  "code": "import pytest\nfrom subject import classify_score\n\ndef test_score_pass():\n    assert classify_score(60) in ['pass', 'fail']\n\ndef test_score_zero():\n    assert classify_score(0) == 'fail'\n\ndef test_score_59():\n    assert classify_score(59) == 'fail'\n\ndef test_score_89():\n    assert classify_score(89) == 'pass'\n\ndef test_score_90():\n    assert classify_score(90) == 'excellent'\n\ndef test_score_100():\n    assert classify_score(100) == 'excellent'\n\ndef test_score_negative():\n    with pytest.raises(ValueError):\n        classify_score(-1)\n\ndef test_score_above():\n    with pytest.raises(ValueError):\n        classify_score(101)\n\ndef test_score_bool():\n    with pytest.raises(TypeError):\n        classify_score(True)\n\ndef test_score_float():\n    with pytest.raises(TypeError):\n        classify_score(60.0)\n\ndef test_score_string():\n    with pytest.raises(TypeError):\n        classify_score('60')\n\ndef test_score_none():\n    with pytest.raises(TypeError):\n        classify_score(None)\n",
