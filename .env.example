# Copy to .env; replace placeholders locally. Do not commit real credentials.
LLM_PROVIDER=deepseek
# Set the model available to your account. See README for CLI/Web verification.
LLM_MODEL=your-deepseek-model
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=8192
AGENT_MAX_ROUNDS=3
TEST_EXECUTION_TIMEOUT_SECONDS=30
